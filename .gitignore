# ── Dependencies ────────────────────────────────
node_modules/
**/node_modules/
dist/
build/

# ── Python virtual env ──────────────────────────
api/venv/
**/venv/
__pycache__/
*.pyc

# ── Secrets & credentials (NEVER COMMIT) ────────
.env
**/.env
*.env
!.env.example
**/.env.example
.solana-keypair.json
**/.solana-keypair.json
.vapid-keys.json
**/.vapid-keys.json
*.pem
*.key

# ── Local databases ─────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3-journal
**/finchat.db*

# ── Logs & runtime artifacts ────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
startup*.log
**/build/

# ── OS / editor ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pptx

# ── Project Specific ────────────────────────────
uploads/
**/uploads/
ipconfig_output.txt
token.txt
system_explanation.txt
{frontend,backend}/

# Pre-theme-unification page backups (superseded by finchat_theme.css)
legacy_prototype/frontend/_pre_theme_backup/

# Tailwind build output — produced in the Dockerfile builder stage (and by
# `npm run build:css` locally), never hand-committed, so it cannot go stale
# against the markup it was generated from.
legacy_prototype/frontend/finchat_tw.css
legacy_prototype/frontend/finchat_tw_audit.css

# Pre-resize avatar sources. The full-resolution originals remain in git
# history; this is just a local working copy from the resize pass.
legacy_prototype/frontend/_avatar_originals/

# Anything derived from a .env file. The `*.env` rule above only matches paths
# ENDING in .env, so .env.bak / .env.local / .env.save slipped through — and a
# pg password ended up in one of them during the Singapore migration.
.env*

# Throwaway diagnostic scripts. They get written next to the code they probe
# rather than in a temp directory, so they show up as untracked beside real
# work and ride along on a `git add -A`.
_tmp_*
