# FinChat Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase (required)
# Example: postgresql://postgres:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# JWT Secret (REQUIRED — the server refuses to boot without at least 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# AI inference (optional; Ollama is used as a fallback where supported)
GROQ_API_KEY=

# IPFS via Pinata (get free API keys at https://pinata.cloud)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Solana (devnet = free, no setup needed)
SOLANA_NETWORK=devnet
SOLANA_RPC=https://api.devnet.solana.com

# Qwen / Ollama local fraud detection
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Background work needs no broker: an external cron service calls /api/cron/tick
# (missions) and /api/cron/briefing (daily brief) with this shared secret.
# Without it those endpoints are disabled and nothing scheduled will run.
CRON_SECRET=change-me

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS — frontend origin
FRONTEND_URL=http://localhost:5500

# Extra browser origins allowed to call this API, comma-separated. FRONTEND_URL
# is always included, and outside production localhost on any port is accepted
# too, so this is usually only needed for a deployed second frontend or a
# staging domain. Anything not listed is rejected — the API no longer reflects
# arbitrary origins back, which is what let any site call it with a user's token.
# Origins are scheme + host + port, no trailing path:
#   ALLOWED_ORIGINS=https://app.finchat.io,https://staging.finchat.io
ALLOWED_ORIGINS=

# === GOOGLE SIGN-IN (optional) ===
# Leave blank and the "Continue with Google" button is not rendered at all —
# the login and signup pages ask GET /api/auth/config first, so an unconfigured
# deployment shows no dead button. Fill it in and the button appears.
#
# To get a client ID:
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create credentials → OAuth client ID → Web application
#   3. Authorised JavaScript origins: every origin the app is served from,
#      i.e. http://localhost:3000 and https://finchat-sg.onrender.com
#      (origin only — no path, and the port must match)
#   4. Paste the "Client ID" below. There is no client secret to set: the
#      browser gets an ID token and the server verifies its signature against
#      Google's public keys, so nothing confidential lives here.
# Accounts are matched on the verified Google email, so signing in with Google
# on an address that already has a password account signs into THAT account.
GOOGLE_CLIENT_ID=

# === GMAIL FOR RASHA (optional) ===
# Lets the career agent read the JOB ALERTS already in the user's inbox
# (LinkedIn, Naukri, Indeed, Internshala, and company careers/ATS senders).
# Read-only, and hard-filtered in code to those senders — it is not a search of
# the mailbox and the agent cannot widen it, reply, send or delete.
#
# This is a DIFFERENT flow from GOOGLE_CLIENT_ID above. Sign-in only verifies a
# token the browser hands over and needs no secret; this obtains a refresh token,
# which needs the client secret and a registered redirect URI.
#   1. Same OAuth client as sign-in (console.cloud.google.com → Credentials)
#   2. Add an Authorised REDIRECT URI (not just an origin):
#        http://localhost:3000/api/integrations/google/callback
#        https://finchat-sg.onrender.com/api/integrations/google/callback
#   3. Copy the client secret below
#   4. APIs & Services → Library → enable the Gmail API
#   5. OAuth consent screen → add yourself under Test users. gmail.readonly is a
#      RESTRICTED scope: fine in Testing mode for your own account, but opening
#      it to other users requires Google's CASA security assessment.
GOOGLE_CLIENT_SECRET=
# Only needed if the app sits behind a proxy that rewrites the origin; otherwise
# it is derived from FRONTEND_URL (or localhost:3000).
GOOGLE_OAUTH_REDIRECT_URI=
# Refresh tokens are encrypted at rest. Unset, the key is derived from
# JWT_SECRET — which works, but means rotating JWT_SECRET forces everyone to
# reconnect Google. Set this to decouple them.
GOOGLE_TOKEN_KEY=

# === ADZUNA JOBS API (optional, but the jobs tool is much worse without it) ===
# The only real jobs API the jobs tool has. Neither LinkedIn nor Indeed offers a
# public one — LinkedIn's is partner-only and Indeed retired its Publisher API —
# so without Adzuna a city search falls back to `site:naukri.com …` web queries,
# and a search engine returns whatever RANKS: usually a board's category page
# ("Business Analyst Jobs in Hyderabad — 2227 Vacancies"), not a single opening.
#
# Adzuna returns individual postings with company, salary band and posting date,
# and it has a dedicated India endpoint. Free tier, no card:
#   1. developer.adzuna.com → sign up
#   2. Copy the Application ID and Application Key from the dashboard
# Both must be set; either one alone is ignored.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# === NOTIFICATION CHANNELS (Sprint 8 — all optional) ===
# Email (any SMTP provider; e.g. Gmail app password, Mailtrap, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinChat <no-reply@finchat.local>

# WhatsApp + SMS via Twilio (WhatsApp from = your Twilio WhatsApp sender, e.g. +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Telegram bot (create with @BotFather; users paste their chat id on the Settings page)
TELEGRAM_BOT_TOKEN=

# Browser/mobile push needs NO config — VAPID keys are auto-generated
# into backend/.vapid-keys.json on first use.

# === WEB SEARCH PROVIDERS ===
# The `search` tool tries these in order: SearxNG -> Tavily -> Brave -> DuckDuckGo.
# The DDG scrape only works from residential IPs; it is silently blackholed from
# datacenter IPs (Render), so a real API key is REQUIRED in production.
#
# Self-hosted SearxNG, if you run one. Free and unmetered, so it is tried first.
# Only useful if BOTH are true, otherwise leave it blank:
#   - the instance has `search: {formats: [html, json]}` in settings.yml (json is OFF
#     by default, and without it this returns an HTML page and yields 0 results)
#   - it runs on a residential/clean IP. SearxNG proxies Google/Bing/DDG, so hosting it
#     on a datacenter IP reproduces exactly the blocking that broke the DDG scrape.
# Public instances do not work here: most disable json, the rest rate-limit (429).
SEARXNG_URL=
# Optional, if your instance sits behind auth (e.g. "Basic <base64>").
SEARXNG_AUTH=

# Tavily is tried before Brave because its free tier hard-stops at the cap, while Brave
# bills the card on file once its monthly credit runs out.
# Tavily: free "Researcher" tier = 1,000 credits/month, no card. https://tavily.com
TAVILY_API_KEY=
# Brave: $5 per 1,000 requests, $5 free credit/month (~1,000 requests). Card required
# (not charged while you stay inside the credit). https://brave.com/search/api/
BRAVE_API_KEY=
# Set true to skip the DDG scrape entirely (recommended on Render — it just burns 12s).
SEARCH_DISABLE_DDG=
