{
    "name": "finchat-backend",
    "version": "0.2.0",
    "description": "FinChat — Governed Internal Messaging Backend",
    "main": "server.js",
    "scripts": {
        "test": "node --test test/",
        "test:watch": "node --test --watch test/",
        "build:css": "tailwindcss -c ../frontend/tailwind.config.js -i ../frontend/tailwind.input.css -o ../frontend/finchat_tw.css --minify && tailwindcss -c ../frontend/tailwind.audit.config.js -i ../frontend/tailwind.input.css -o ../frontend/finchat_tw_audit.css --minify",
        "watch:css": "tailwindcss -c ../frontend/tailwind.config.js -i ../frontend/tailwind.input.css -o ../frontend/finchat_tw.css --watch",
        "start": "node server.js",
        "start:3100": "set PORT=3100&& node server.js",
        "dev": "nodemon server.js",
        "migrate:up": "node-pg-migrate up",
        "migrate:create": "node-pg-migrate create",
        "verify": "node scripts/verify-config.js"
    },
    "dependencies": {
        "@solana/web3.js": "^1.98.4",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.80.3",
        "circom_runtime": "^0.1.28",
        "circomlib": "^2.0.5",
        "circomlibjs": "^0.1.7",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.6.2",
        "form-data": "^4.0.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.12.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^9.0.3",
        "pdf-parse": "^2.4.5",
        "pg": "^8.11.3",
        "redis": "^4.6.13",
        "snarkjs": "^0.7.6",
        "socket.io": "^4.7.2",
        "uuid": "^9.0.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.11",
        "node-pg-migrate": "^7.8.0",
        "nodemon": "^3.0.3",
        "socket.io-client": "^4.8.3",
        "tailwindcss": "^3.4.19"
    },
    "comments": {
        "overrides": [
            "Advisories in deep transitives of the ZKP stack, which pins them so `npm audit fix` cannot reach them.",
            "underscore <- jsonpath <- bfj <- snarkjs. ws <- @ethersproject/providers <- ethers@5 <- circomlibjs.",
            "Both are safe to float: the ZKP path (services/zkp.js) does Groth16 proving offline and never opens a socket, so the ws bump is not on any code path we execute; underscore is used by jsonpath's expression parser only.",
            "Revisit if snarkjs or circomlibjs ever publish releases that update these themselves."
        ]
    },
    "overrides": {
        "underscore": "^1.13.7",
        "ws": "^8.18.3"
    }
}
